{
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{dsxpod/**,data/**,public/**}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}