#usda 1.0
(
    defaultPrim = "GADU_Chiller"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "GADU_Chiller" (
    kind = "component"
)
{
    custom string aif:core:assetClass = "air-cooled chiller skid (procedural)"
    custom string aif:core:assetDescription = "generic packaged air-cooled chiller: compressor section, V-coil louvers, 4 top fans; used by GADU units (1-2 per unit); generated by dsxpod/assetgen.py"
    custom float3 aif:core:overallGeometryDimensions = (6000, 2400, 2600)

    def Scope "Looks"
    {
        def Material "White"
        {
            token outputs:surface.connect = </GADU_Chiller/Looks/White/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.87, 0.86)
                float inputs:metallic = 0.25
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Band"
        {
            token outputs:surface.connect = </GADU_Chiller/Looks/Band/Surface.outputs:surface>

