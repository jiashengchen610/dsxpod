#usda 1.0
(
    defaultPrim = "DSXPOD_Container"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DSXPOD_Container" (
    kind = "component"
)
{
    custom string aif:core:assetClass = "DSX POD compute container shell (procedural)"
    custom string aif:core:assetDescription = "ISO 40 ft high-cube shell, 6 long-side service doors (south), corrugated walls, corner castings; generated by dsxpod/assetgen.py"
    custom float3 aif:core:overallGeometryDimensions = (12192, 2438, 2896)

    def Scope "Looks"
    {
        def Material "White"
        {
            token outputs:surface.connect = </DSXPOD_Container/Looks/White/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.87, 0.86)
                float inputs:metallic = 0.25
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Band"
